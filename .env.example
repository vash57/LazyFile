# LazyFile configuration. Copy to .env or export these variables in your shell.
# Every setting is optional; the defaults below are what LazyFile uses.

# Web dashboard
LAZYFILE_HOST=127.0.0.1
LAZYFILE_PORT=8765

# Where the append-only operation log is stored.
LAZYFILE_DATA_DIR=~/.lazyfile

# Scan limits. Lower these on very large folders or slow machines.
LAZYFILE_MAX_FILES=3000
LAZYFILE_MAX_DEPTH=16
LAZYFILE_AI_MAX_FILES=80

# Optional local AI through Ollama. Rules work without any of this.
OLLAMA_URL=http://127.0.0.1:11434
# Leave empty to use the smallest installed model automatically.
OLLAMA_MODEL=
OLLAMA_TIMEOUT=60
